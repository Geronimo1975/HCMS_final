{
  "editor": {
    "formatOnSave": true,
    "tabSize": 4,
    "insertSpaces": true,
    "rulers": [88],
    "wordWrap": "off",
    "bracketPairColorization.enabled": true,
    "guides.bracketPairs": true,
    "suggestSelection": "first",
    "acceptSuggestionOnEnter": "on"
  },
  "python": {
    "linting": {
      "enabled": true,
      "pylintEnabled": true,
      "flake8Enabled": true,
      "mypyEnabled": true,
      "pylintArgs": [
        "--load-plugins=pylint_django",
        "--django-settings-module=config.settings"
      ],
      "flake8Args": [
        "--max-line-length=88",
        "--extend-ignore=E203"
      ]
    },
    "formatting": {
      "provider": "black",
      "blackPath": "black",
      "blackArgs": ["--line-length", "88"]
    },
    "analysis": {
      "typeCheckingMode": "basic",
      "diagnosticMode": "workspace",
      "useLibraryCodeForTypes": true,
      "autoImportCompletions": true
    },
    "envFile": "${workspaceFolder}/.env"
  },
  "django": {
    "templates": {
      "autoClosingTags": true,
      "formatOnSave": true,
      "snippets": {
        "enabled": true
      }
    },
    "intellisense": {
      "enabled": true,
      "suggestions": true,
      "autoImport": true
    }
  },
  "search": {
    "exclude": {
      "**/node_modules": true,
      "**/bower_components": true,
      "**/*.code-search": true,
      "**/venv": true,
      "**/.git": true,
      "**/migrations": false,
      "**/templates": false
    },
    "quickOpen": {
      "includeSymbols": true
    }
  },
  "files": {
    "exclude": {
      "**/.git": true,
      "**/__pycache__": true,
      "**/venv": true,
      "**/node_modules": true,
      "**/.DS_Store": true,
      "**/migrations": false,
      "**/templates": false
    },
    "watcherExclude": {
      "**/.git/objects/**": true,
      "**/.git/subtree-cache/**": true,
      "**/node_modules/**": true,
      "**/venv/**": true
    },
    "associations": {
      "*.html": "django-html",
      "*.py": "python"
    }
  },
  "emmet": {
    "includeLanguages": {
      "django-html": "html"
    }
  },
  "terminal": {
    "integrated": {
      "shell": {
        "linux": "/usr/bin/bash"
      }
    }
  }
} 